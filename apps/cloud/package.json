{
  "name": "@token-island/cloud",
  "version": "0.3.0",
  "private": true,
  "description": "Token Island cloud (V3): pixel badges/charts/cards/pages with a dual runtime — Cloudflare Workers + D1 (production) and Node + SQLite (local dev / Docker / tests).",
  "type": "module",
  "main": "src/node.ts",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-warnings node --import tsx src/node.ts",
    "start": "NODE_OPTIONS=--no-warnings node --import tsx src/node.ts",
    "seed": "NODE_OPTIONS=--no-warnings node --import tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--no-warnings node --import tsx --test test/*.test.ts",
    "worker:dev": "XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-../../.runtime/xdg} XDG_CACHE_HOME=${XDG_CACHE_HOME:-../../.runtime/xdg-cache} wrangler dev --port 47131 --persist-to ../../.runtime/wrangler-state",
    "worker:migrate": "XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-../../.runtime/xdg} XDG_CACHE_HOME=${XDG_CACHE_HOME:-../../.runtime/xdg-cache} wrangler d1 migrations apply token-island-cloud --local --persist-to ../../.runtime/wrangler-state",
    "worker:deploy": "XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-../../.runtime/xdg} XDG_CACHE_HOME=${XDG_CACHE_HOME:-../../.runtime/xdg-cache} wrangler deploy",
    "worker:dry-run": "XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-../../.runtime/xdg} XDG_CACHE_HOME=${XDG_CACHE_HOME:-../../.runtime/xdg-cache} wrangler deploy --dry-run --outdir ../../.runtime/worker-dist",
    "worker:seed": "NODE_OPTIONS=--no-warnings node --import tsx scripts/seed-worker.ts"
  },
  "dependencies": {
    "@token-island/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
