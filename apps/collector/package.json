{
  "name": "@token-island/collector",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first token collector daemon: parses Claude Code, OpenAI Codex, OpenCode and DeepSeek Harness session logs into SQLite and serves a local HTTP API.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-warnings node --import tsx src/index.ts collect",
    "start": "NODE_OPTIONS=--no-warnings node --import tsx src/index.ts collect",
    "collect": "NODE_OPTIONS=--no-warnings node --import tsx src/index.ts collect",
    "sync": "NODE_OPTIONS=--no-warnings node --import tsx src/index.ts sync",
    "status": "NODE_OPTIONS=--no-warnings node --import tsx src/index.ts status",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--no-warnings node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@token-island/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
